    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.31",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
