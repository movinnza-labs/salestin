# ── Local development ─────────────────────────────────────────────────────────

# PostgreSQL connection string (Payload's official @payloadcms/db-postgres adapter).
# On Railway: ${{Postgres.DATABASE_URL}} — the PRIVATE URL (*.railway.internal), which is not billed as traffic.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/selestin

# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value in production.
PAYLOAD_SECRET=replace-with-a-secure-random-secret

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional — email notification for new enquiries. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=SELESTIN Professional

# ── Railway only (not needed locally) ─────────────────────────────────────────

# The build pre-renders pages from the database, and Railway's private network is not
# available during builds, so the build uses the PUBLIC URL: ${{Postgres.DATABASE_PUBLIC_URL}}
# BUILD_DATABASE_URL=

# Already set in the Dockerfile; listed so it is not forgotten if the image changes.
# Fewer glibc memory arenas — stops native memory growth from sharp.
# MALLOC_ARENA_MAX=2
