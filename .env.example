# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email delivery for website enquiries (sent to the enquiry address in src/content/site-settings.json).
# Enquiries are not stored anywhere else: in production, leaving SMTP_HOST empty makes the contact form fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=SELESTIN Professional
